menu "Tailscale Manager"

    config TS_ENABLE
        bool "Enable tailscale lane (microlink)"
        default n
        help
            Runs the microlink Tailscale client alongside the voice stack.
            The AMOLED example does not require this component; only boards
            that call tailscale_manager_start() with TS_ENABLE=y build the
            microlink+wireguard_lwip objects in.

    config TS_AUTH_KEY
        string "Tailscale auth key (tskey-auth-...)"
        default "tskey-auth-XXXXX-put-real-key-in-overlay-XXXXXXXXXXXXXXXXXXXX"
        help
            Only needed when the board must REGISTER fresh (empty NVS or key
            expiry). The board keeps its machine keys in NVS across reflash
            (NVS partition identical), so an already-registered board needs
            no valid key. Real value belongs in the git-ignored
            sdkconfig.credentials overlay.

    config TS_PRIORITY_PEER_IP
        string "Priority peer VPN IP (guaranteed WG slot, e.g. the daemon)"
        default "100.124.254.15"
        help
            VM2 (openclaws-virtual-machine-2) — the daemon always gets a
            WireGuard slot even on a full peer table. 0/empty disables.

    config TS_GATEWAY_DNS_NAME
        string "Gateway hostname the echo-lane resolver pins (e.g. the ts.net name)"
        default "wss://openclaws-virtual-machine-2.tailbdd5a.ts.net"
        help
            Scheme and port are stripped automatically. ts_manager asks VM2's
            dns lane (:5200 keepalive-primed responder) for this name's A
            record and registers it into lwIP's netconn external-resolve hook —
            MagicDNS names resolve with zero real-network DNS. Empty disables.

endmenu